{
  "name": "dbautorun",
  "version": "1.0.2",
  "description": "Run files and folders of SQL scripts against SQL Server, Oracle, PostgreSQL or MySQL/MariaDB from a local web app.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dbautorun": "server.js"
  },
  "files": [
    "server.js",
    "lib",
    "public"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test --experimental-test-module-mocks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Putheara-hun/scriptrunner.git"
  },
  "dependencies": {
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "oracledb": "^26.0.0",
    "pg": "^8.23.1"
  }
}
